<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Level 1: Deep Blue-Tinted Shadow -->
    <item
        android:bottom="0dp"
        android:left="8dp"
        android:right="8dp"
        android:top="12dp">
        <shape>
            <solid android:color="#1A1E5AD1" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Main Gradient Body -->
    <item
        android:bottom="8dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#5083ED"
                android:centerColor="#266FEF"
                android:endColor="#1E5AD1"
                android:type="linear" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    
    <!-- Premium Inner Glow Rim -->
    <item
        android:bottom="8dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <corners android:radius="30dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
