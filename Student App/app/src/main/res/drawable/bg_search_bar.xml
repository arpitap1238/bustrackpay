<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Level 1: Multi-Layered Sapphire Shadow for Depth -->
    <item
        android:top="2dp" 
        android:left="2dp" 
        android:right="2dp" 
        android:bottom="0dp">
        <shape>
            <solid android:color="#1A266FEF" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <!-- Level 2: Main Body with Sapphire-Tinted Edge -->
    <item
        android:bottom="2.5dp"
        android:left="1dp"
        android:right="1dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.2dp"
                android:color="#D1DCEB" />
        </shape>
    </item>
</layer-list>
