<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sophisticated Deep Blue Shadow -->
    <item
        android:bottom="0dp"
        android:left="6dp"
        android:right="6dp"
        android:top="12dp">
        <shape>
            <solid android:color="#1A1E5AD1" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Main Gradient Body -->
    <item
        android:bottom="8dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="135"
                android:endColor="#1E5AD1"
                android:startColor="#266FEF"
                android:type="linear" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Glassmorphic Inner Shine -->
    <item
        android:bottom="9dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape>
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
