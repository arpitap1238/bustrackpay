<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Level 1: Deep Soft Shadow -->
    <item
        android:bottom="2dp"
        android:left="6dp"
        android:right="6dp"
        android:top="10dp">
        <shape>
            <solid android:color="#08000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <!-- Level 2: Medium Soft Shadow -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="6dp">
        <shape>
            <solid android:color="#0A000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Content Layer (The Glass) -->
    <item
        android:bottom="8dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="135"
                android:endColor="#F9FBFF"
                android:startColor="#FFFFFF" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Subtle Inner Border for High-End Look -->
    <item
        android:bottom="8dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#F1F5F9" />
        </shape>
    </item>
</layer-list>
