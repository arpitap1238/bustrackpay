<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- FULL SCREEN MAP CORE -->
    <fragment
        android:id="@+id/driver_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- DUTY STATUS OVERLAY (TOP PILL) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_duty_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_anchor="@id/driver_map"
        app:layout_anchorGravity="top|center_horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="#FFFFFF">
            <View
                android:id="@+id/view_status_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/pulse_dot"
                android:backgroundTint="#CBD5E1" />
            <TextView
                android:id="@+id/tv_duty_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="OFFLINE"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- DUTY MANAGEMENT BOTTOM SHEET -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/duty_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="36dp"
        app:cardElevation="24dp"
        app:contentPadding="0dp"
        app:behavior_peekHeight="290dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="0dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:background="#E2E8F0" />

            <!-- Duty Header Area -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="28dp"
                android:layout_marginBottom="24dp">
                
                <LinearLayout
                    android:id="@+id/layout_header_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_duty_toggle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:id="@+id/tv_route_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Syncing Route..."
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />
                    <TextView
                        android:id="@+id/tv_bus_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Bus #--"
                        android:textColor="#64748B"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_duty_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="START DUTY"
                    android:paddingHorizontal="24dp"
                    android:backgroundTint="#0F67FD"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="24dp"/>

            <!-- Route Timeline Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:text="ROUTE PROGRESS"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="16dp" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/layout_stops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp"
                    android:paddingBottom="140dp" />
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
