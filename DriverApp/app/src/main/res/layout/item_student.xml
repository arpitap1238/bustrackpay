<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_service_card"
    android:padding="20dp">

    <TextView
        android:id="@+id/iv_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="A"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/bg_onboarding_circle"
        android:backgroundTint="#0F67FD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
 Riverside: converted to initials avatar

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_avatar"
        app:layout_constraintTop_toTopOf="@id/iv_avatar">

        <TextView
            android:id="@+id/tv_student_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tv_enrollment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENR-10293"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/iv_avatar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:id="@+id/badge_fee_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FEES PAID"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#065F46"
            android:background="@drawable/bg_onboarding_circle"
            android:backgroundTint="#D1FAE5" />

        <TextView
            android:id="@+id/badge_pass_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VALID PASS"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1E40AF"
            android:background="@drawable/bg_onboarding_circle"
            android:backgroundTint="#DBEAFE"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
