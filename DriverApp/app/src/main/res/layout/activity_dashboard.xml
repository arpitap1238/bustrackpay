<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_dashboard"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="120dp">

        <!-- Header area for Driver Hub -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, Driver"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus #42"
                    android:textColor="#1E293B"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/bg_apple_container"
                android:background="@drawable/bg_circle_white"
                android:padding="8dp"
                android:elevation="2dp"
                app:tint="#2563EB" />
        </LinearLayout>

        <!-- 1. IMAGE-MATCH FEATURED HERO CARD (Tracking Status) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_featured"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_featured_card"
            app:layout_constraintTop_toBottomOf="@id/layout_header">
            
            <View
                android:id="@+id/layout_tracking_hud"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_featured_card" />

            <TextView
                android:id="@+id/lbl_status_hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="TRANSMISSION STATUS"
                android:textColor="#E0F2FE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_tracking_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tracking Offline"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                app:layout_constraintStart_toStartOf="@id/lbl_status_hero"
                app:layout_constraintTop_toBottomOf="@id/lbl_status_hero" />

            <TextView
                android:id="@+id/tv_tracking_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to begin live broadcast"
                android:textColor="#BAE6FD"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/tv_tracking_title"
                app:layout_constraintTop_toBottomOf="@id/tv_tracking_title" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_toggle_tracking"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/btn_rounded_primary"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="32dp"
                android:text="GO LIVE"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_tracking_title" />

            <!-- Animated Icon Placeholder -->
            <ImageView
                android:id="@+id/iv_tracking_status"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/ic_bus_logo"
                android:alpha="0.15"
                android:rotation="15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. SERVICE GRID (2x2) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:rowCount="1"
            app:layout_constraintTop_toBottomOf="@id/card_featured">

            <!-- Card 1: Route Manifest -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_route_info"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/bg_service_card"
                android:padding="20dp">

                <View
                    android:id="@+id/icon_bg_1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_tint_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_route"
                    app:layout_constraintBottom_toBottomOf="@id/icon_bg_1"
                    app:layout_constraintEnd_toEndOf="@id/icon_bg_1"
                    app:layout_constraintStart_toStartOf="@id/icon_bg_1"
                    app:layout_constraintTop_toTopOf="@id/icon_bg_1"
                    app:tint="#2563EB" />

                <TextView
                    android:id="@+id/tv_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Route"
                    android:textColor="#1E293B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icon_bg_1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="View Manifest"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title_1" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 2: Student Roster -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_students"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/bg_service_card"
                android:padding="20dp">

                <View
                    android:id="@+id/icon_bg_2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_tint_green"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    app:layout_constraintBottom_toBottomOf="@id/icon_bg_2"
                    app:layout_constraintEnd_toEndOf="@id/icon_bg_2"
                    app:layout_constraintStart_toStartOf="@id/icon_bg_2"
                    app:layout_constraintTop_toTopOf="@id/icon_bg_2"
                    app:tint="#10B981" />

                <TextView
                    android:id="@+id/tv_title_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Students"
                    android:textColor="#1E293B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icon_bg_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Manage Roster"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title_2" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
