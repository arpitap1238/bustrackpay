<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft, minimalist background -->
    <item>
        <shape>
            <solid android:color="#F1F5F9" />
        </shape>
    </item>
    
    <!-- Sophisticated Accent Blur (Top-Right) -->
    <item android:top="-300dp" android:right="-300dp">
        <shape>
            <size android:width="800dp" android:height="800dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:startColor="#123B82F6"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Professional Secondary Blur (Bottom-Left) -->
    <item android:bottom="-200dp" android:left="-200dp">
        <shape>
            <size android:width="600dp" android:height="600dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#086366F1"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>

